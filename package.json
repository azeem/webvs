{
  "name": "webvs",
  "version": "3.0.0",
  "description": "Audio Visualization rendering library",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vite --config vitest.config.mts --open /examples/",
    "smoke-test": "node test/smoke/smoke.mjs",
    "func-test": "vitest run --project func",
    "unit-test": "vitest run --project unit",
    "lint": "tslint -c tslint.json -e \"src/expr/ExprGrammar.d.ts\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "gen:grammar": "peggy --format es --dts -o src/expr/ExprGrammar.js src/expr/ExprGrammar.pegjs"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/azeem/webvs.git"
  },
  "author": "Azeem Arshad",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/azeem/webvs/issues"
  },
  "dependencies": {
    "stats.js": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "peggy": "5.1.0",
    "playwright": "1.64.1",
    "seedrandom": "^2.4.3",
    "tsdown": "0.23.1",
    "tslint": "5.9.1",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@types/lodash": "4.14.107",
    "@types/glob": "5.0.35",
    "@types/normalize-package-data": "2.4.0"
  }
}
