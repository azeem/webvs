{
  "name": "@visbot/webvs",
  "version": "4.0.0",
  "description": "Audio Visualization rendering library",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vite --config vitest.config.mts --open /examples/",
    "smoke-test": "node test/smoke/smoke.mjs",
    "func-test": "vitest run --project func",
    "unit-test": "vitest run --project unit",
    "lint": "oxlint --deny-warnings src test"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/visbot/webvs.git"
  },
  "author": "Azeem Arshad",
  "contributors": [
    "Jan T. Sott (https://github.com/idleberg)",
    "Jakob Karge (https://github.com/grandchild)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/visbot/webvs/issues"
  },
  "dependencies": {
    "stats.js": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "oxlint": "1.90.0",
    "peggy": "5.1.1",
    "playwright": "1.64.1",
    "seedrandom": "3.0.5",
    "tsdown": "0.23.4",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
